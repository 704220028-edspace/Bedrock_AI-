# ── SCAN EM TEMPO REAL (Server-Sent Events) ──
@app.route('/scan-stream', methods=['GET'])
def scan_stream():
    """Envia progresso do scan passo a passo via SSE."""
    email = request.args.get('email', '').strip().lower()
    hoje = datetime.date.today()

    def gerar_eventos():
        if email not in DATABASE_ASSINANTES:
            yield "data: ERRO:E-mail não encontrado no sistema.\n\n"
            return

        cliente = DATABASE_ASSINANTES[email]

        if hoje > cliente["validade"]:
            yield "data: ERRO:Assinatura expirada. Renove para continuar protegido.\n\n"
            return

        pastas = cliente["pastas_limpas"] or ["C:\\System32", "C:\\Windows\\Temp"]

        yield f"data: LOG:🔐 Autenticando {cliente['nome']}...\n\n"
        time.sleep(0.8)

        yield f"data: LOG:✅ Plano {cliente['plano']} confirmado.\n\n"
        time.sleep(0.6)

        yield f"data: LOG:📂 Carregando {len(BANCO_DE_VIRUS)} assinaturas de vírus...\n\n"
        time.sleep(0.8)

        total_ficheiros = 0
        for i, pasta in enumerate(pastas):
            yield f"data: LOG:🔍 Escaneando: {pasta}\n\n"
            time.sleep(0.7)

            # Simula ficheiros encontrados
            ficheiros = (i + 1) * 47 + len(pasta)
            total_ficheiros += ficheiros
            yield f"data: PROGRESS:{int(((i+1)/len(pastas))*80)}\n\n"
            time.sleep(0.5)

        yield f"data: LOG:🧬 Verificando processos em memória RAM...\n\n"
        time.sleep(0.9)
        yield f"data: PROGRESS:90\n\n"

        yield f"data: LOG:🛡 Validando integridade do sistema...\n\n"
        time.sleep(0.7)

        removidos = cliente["virus_removidos"]
        yield f"data: LOG:🚫 Ameaças eliminadas: {removidos} arquivo(s) malicioso(s)\n\n"
        time.sleep(0.5)

        if cliente["plano"] == "B and G":
            yield "data: LOG:🔥 [B and G] Firewall de rede reforçado.\n\n"
            time.sleep(0.4)
            yield "data: LOG:📡 [B and G] IPs suspeitos bloqueados.\n\n"
            time.sleep(0.4)

        yield f"data: PROGRESS:100\n\n"
        time.sleep(0.3)
        yield f"data: DONE:{total_ficheiros} ficheiros analisados. {removidos} ameaças removidas.\n\n"

        # Atualiza último scan
        DATABASE_ASSINANTES[email]["ultimo_scan"] = hoje.strftime("%Y-%m-%d")

    return app.response_class(gerar_eventos(), mimetype='text/event-stream',
                              headers={"Cache-Control": "no-cache", "X-Accel-Buffering": "no"})


@app.route('/analisar-phishing', methods=['POST'])
def analisar_phishing():
    texto = request.form.get('texto_email', '').lower()
    gatilhos = [
        "urgente", "clique aqui", "sua conta foi bloqueada",
        "atualize seus dados", "ganhou", "herança",
        "vencerá hoje", "sua senha expirou", "transferência imediata",
        "confirme seus dados", "acesso suspenso", "prêmio", "grátis por tempo limitado"
    ]
    encontrados = [g for g in gatilhos if g in texto]
    pontos = len(encontrados)

    if pontos >= 2:
        return tela("🚨 Phishing Detectado!",
            f"Padrão de engenharia social identificado.<br>"
            f"<strong>Gatilhos:</strong> {', '.join(encontrados)}.<br><br>"
            "❌ Não clique em links. Delete esta mensagem.", "#ff3355")
    elif pontos == 1:
        return tela("⚠️ Mensagem Suspeita",
            f"Gatilho encontrado: <strong>{encontrados[0]}</strong>.<br>"
            "Verifique o remetente com cuidado.", "#ffcc00")
    else:
        return tela("✅ E-mail Seguro",
            "Nenhum padrão de phishing detectado pelo Bedrock IA.", "#00ff88")


@app.route('/verificar-hash', methods=['POST'])
def verificar_hash():
    hash_md5 = request.form.get('hash_md5', '').strip().lower()
    if len(hash_md5) != 32:
        return tela("⚠️ Hash Inválido", "MD5 deve ter exatamente 32 caracteres.", "#ffcc00")
    if hash_md5 in BANCO_DE_VIRUS:
        return tela("🚨 Arquivo Malicioso!",
            f"<strong>Ameaça:</strong> {BANCO_DE_VIRUS[hash_md5]}<br><br>"
            "⛔ Não execute nem compartilhe este arquivo.", "#ff3355")
    return tela("✅ Hash Limpo",
        "Hash não encontrado no banco de ameaças. Arquivo aparentemente seguro.", "#00ff88")


@app.route('/gerar-relatorio', methods=['POST'])
def gerar_relatorio():
    email = request.form.get('email_relatorio', '').strip().lower()
    hoje = datetime.date.today()
    if email not in DATABASE_ASSINANTES:
        return tela("❌ Não Encontrado", "E-mail não localizado.", "#ff3355")
    c = DATABASE_ASSINANTES[email]
    status = "✅ ATIVA" if hoje <= c["validade"] else "❌ EXPIRADA"
    dias = (c["validade"] - hoje).days
    rel = (f"<strong>Relatório:</strong> {hoje.strftime('%d/%m/%Y')}<br><br>"
           f"👤 {c['nome']} — {email}<br>💎 Plano: {c['plano']}<br>"
           f"📅 Validade: {c['validade'].strftime('%d/%m/%Y')} — {status}<br>")
    if hoje <= c["validade"]:
        rel += f"⏳ {dias} dias restantes<br>"
    rel += (f"<br>🕐 Último scan: {c['ultimo_scan']}<br>"
            f"🚫 Vírus removidos: {c['virus_removidos']}<br>")
    for p in c["pastas_limpas"]:
        rel += f"&nbsp;&nbsp;→ {p}<br>"
    cor = "#00ff88" if hoje <= c["validade"] else "#ff3355"
    return tela("📋 Relatório de Segurança", rel, cor)


