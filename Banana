@app.route('/checkout/<plano>')
def checkout(plano):
    """Cria sessão de pagamento no Stripe e redireciona."""
    precos = {"usuario": PRICE_USUARIO, "bg": PRICE_BG}
    if plano not in precos:
        return tela("❌ Plano Inválido", "Escolhe um plano válido.", "#ff3355")

    try:
        session = stripe.checkout.Session.create(
            payment_method_types=["card"],
            line_items=[{"price": precos[plano], "quantity": 1}],
            mode="subscription",
            success_url=request.host_url + "pagamento-sucesso?session_id={CHECKOUT_SESSION_ID}",
            cancel_url=request.host_url + "pagamento-cancelado",
        )
        return redirect(session.url, code=303)
    except Exception as e:
        return tela("❌ Erro no Pagamento", f"Não foi possível iniciar o checkout: {str(e)}", "#ff3355")


